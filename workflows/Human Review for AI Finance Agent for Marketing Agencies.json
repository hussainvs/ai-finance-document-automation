    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "={{ $('Review Input').item.json.review_email }}",
        "subject": "={{ 'Please review invoice: ' + $('Review Input').item.json.file_name }}",
        "message": "={{ 'The finance agent is not sure about this document and needs your check before saving it.\\n\\nFile: ' + $('Review Input').item.json.file_name + '\\nLink: ' + $('Review Input').item.json.file_link + '\\nSender (issued by): ' + (($('Review Input').item.json.extracted || {}).issued_by || '-') + '\\nBill to: ' + (($('Review Input').item.json.extracted || {}).billed_to || '-') + '\\nAI thinks: ' + (($('Review Input').item.json.extracted || {}).transaction_type || '-') + ' / ' + (($('Review Input').item.json.extracted || {}).category || '-') + '\\nAI confidence: ' + $('Review Input').item.json.confidence + '%\\nMissing fields: ' + ($('Review Input').item.json.missing_fields || 'none') + '\\nAI note: ' + (($('Review Input').item.json.extracted || {}).review_reason || '-') + '\\n\\nOpen the form, correct anything that is wrong, then choose Approve or Reject. If nobody answers within 24 hours the file moves to the Needs Review folder.' }}",
        "responseType": "customForm",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Decision",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Approve"
                  },
                  {
                    "option": "Reject"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Transaction Type",
              "fieldType": "dropdown",
              "defaultValue": "={{ String(($('Review Input').item.json.extracted || {}).transaction_type || 'expense').toLowerCase() }}",
              "fieldOptions": {
                "values": [
                  {
                    "option": "income"
                  },
                  {
                    "option": "expense"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Category",
              "fieldType": "dropdown",
              "defaultValue": "={{ ($('Review Input').item.json.extracted || {}).category || 'Other Expense' }}",
              "fieldOptions": {
